{
  "manifest_version": 2,
  "name": "Real Black Mode",
  "version": "1.0",
  "description": "Toggles between custom and default website colors. It's a fork/retake on Toggle Website Colors (Global) by Manuel Reimer. Thanks for the base!",
  "browser_specific_settings": {
    "gecko": {
      "id": "realdarkmode@beta",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "24": "icons/toggleglobalcolors.svg",
    "32": "icons/toggleglobalcolors.svg",
    "50": "icons/toggleglobalcolors.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "browser_style": true,
    "default_icon": "icons/toggleglobalcolors.svg",
    "default_title": "Real Black Mode"
  },
  "commands": {
    "toggle-colors": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "Toggle website colors"
    },
    "open-options": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Open Real Black Mode options"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["browserSettings", "downloads", "menus"]
}